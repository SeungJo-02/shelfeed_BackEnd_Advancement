# Database
DB_URL=jdbc:mysql://localhost:3307/shelfeed?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=

# JWT
JWT_SECRET=

# Redis
REDIS_HOST=localhost
# 운영: redis --requirepass 와 앱 spring.data.redis.password 가 공유하는 비밀번호. 로컬은 비워도 됨
REDIS_PASSWORD=

# Grafana (운영 모니터링) — 운영 배포 시 반드시 설정
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback/google

# Aladin API
ALADIN_API_KEY=

# CORS
CORS_ALLOWED_ORIGIN=http://localhost:5173
