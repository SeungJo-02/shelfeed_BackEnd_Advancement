  "panels": [
    {
      "id": 156,
      "type": "row",
      "title": "실험 A — 가설과 읽는 법",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
