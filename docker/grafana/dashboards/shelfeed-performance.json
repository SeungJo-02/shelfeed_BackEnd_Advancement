     "unit": "short"
    }
   },
   "options": {
    "tooltip": {
     "mode": "single"
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Requests per Second",
   "description": "초당 처리 요청 수",
   "gridPos": {
    "x": 8,
    "y": 19,
    "w": 8,
    "h": 8
