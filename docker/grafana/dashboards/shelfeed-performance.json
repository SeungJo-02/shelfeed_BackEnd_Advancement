{
 "uid": "shelfeed-perf",
 "title": "Shelfeed 성능 대시보드",
 "tags": [
  "k6",
  "shelfeed",
  "performance"
 ],
 "timezone": "browser",
 "schemaVersion": 38,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "timepicker": {},
 "panels": [
  {
   "id": 900,
   "type": "row",
   "title": "🔥 조회수 장애 재현 — 인기글 행 락 경합",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "id": 901,
   "type": "timeseries",
   "title": "API별 RPS",
   "description": "인기글 폭풍이 시작되면 /reviews/{reviewId}가 치솟는다",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (uri) (rate(http_server_requests_seconds_count{uri=~\"/api/v1/.*\"}[1m]))",
     "legendFormat": "{{uri}}",
     "refId": "A"
    }
   ]
  },
  {
   "id": 902,
   "type": "timeseries",
   "title": "p99 응답시간 — 상세 API vs 무관한 API",
   "description": "핵심 증거: 조회수와 무관한 API까지 함께 느려진다 = 공유 자원 문제",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=\"/api/v1/reviews/{reviewId}\"}[1m])))",
     "legendFormat": "감상글 상세 p99",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{uri=~\"/api/v1/.*\", uri!=\"/api/v1/reviews/{reviewId}\"}[1m])))",
     "legendFormat": "무관한 API p99",
     "refId": "B"
    }
   ]
  },
  {
   "id": 903,
   "type": "timeseries",
   "title": "HikariCP — Active / Pending / Max",
   "description": "Pending>0 = 커넥션 풀 고갈. 락 경합의 가장 빠른 신호",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "hikaricp_connections_active",
     "legendFormat": "Active",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "hikaricp_connections_pending",
     "legendFormat": "Pending",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "hikaricp_connections_max",
     "legendFormat": "Max",
     "refId": "C"
    }
   ]
  },
  {
   "id": 904,
   "type": "timeseries",
   "title": "InnoDB 행 락 — 대기 발생률 / 평균 대기시간",
   "description": "진범 지표: 같은 행 UPDATE 직렬화가 여기 나타난다",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "drawStyle": "line",
      "lineWidth": 2,
      "fillOpacity": 12,
      "showPoints": "never",
      "spanNulls": true
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "max",
      "lastNotNull"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(mysql_global_status_innodb_row_lock_waits[1m])",
     "legendFormat": "행 락 대기 발생 (waits/s)",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(mysql_global_status_innodb_row_lock_time[1m]) / rate(mysql_global_status_innodb_row_lock_waits[1m])",
     "legendFormat": "평균 대기시간 (ms)",
     "refId": "B"
    }
   ]
  },
