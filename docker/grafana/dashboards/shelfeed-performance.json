   "datasource": {
    "type": "influxdb",
    "uid": "influxdb-k6"
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "influxdb",
      "uid": "influxdb-k6"
     },
     "query": "SELECT mean(\"value\") FROM \"vus\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
     "rawQuery": true,
     "resultFormat": "time_series",
     "alias": "VUs"
